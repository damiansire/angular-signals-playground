{
  "name": "angular-signals-playground",
  "version": "0.0.0",
  "description": "An interactive playground and introduction to learning Angular Signals (computed, effect, linkedSignal, resource) hands-on.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "angular",
    "signals",
    "examples"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\" \"scripts/*.mjs\"",
    "gate:prosa": "node scripts/prose-budget.mjs",
    "gate:prosa:update": "node scripts/prose-budget.mjs --update",
    "test:scripts": "node --test \"scripts/*.test.mjs\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "gsap": "^3.15.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "@types/jasmine": "~6.0.0",
    "angular-eslint": "22.8.0",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
